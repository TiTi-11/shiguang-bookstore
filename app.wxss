/* 全局基础样式 */
page {
  background: #f6f6f6;
  color: #222;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view,
text,
image,
scroll-view {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.muted {
  color: #999;
}

.price {
  color: #e6543a;
  font-weight: 600;
}

.price::before {
  content: "¥";
  font-size: 0.75em;
  margin-right: 2rpx;
}

/* 主按钮 */
.btn-primary {
  background: #fcc37a;
  color: #4a3216;
  font-weight: 600;
  border-radius: 999rpx;
  text-align: center;
}

.btn-ghost {
  background: #fff;
  color: #2c3e50;
  border: 1rpx solid #dcdfe6;
  border-radius: 999rpx;
  text-align: center;
}

/* 一行省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 两行省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
}

/* 分割线 */
.hr {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}
