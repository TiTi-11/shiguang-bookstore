.page {
  padding: 20rpx 24rpx 160rpx;
}

/* 封面区 */
.hero {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.hero-cover {
  width: 300rpx;
  height: 428rpx;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* 主信息 */
.info {
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.now {
  color: #e6543a;
  font-size: 44rpx;
  font-weight: 700;
}

.ori {
  color: #bbb;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 14rpx;
}

.sales {
  margin-left: auto;
  color: #aaa;
  font-size: 22rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 12rpx;
  line-height: 1.4;
}

.sub {
  display: block;
  color: #888;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  font-size: 22rpx;
  color: #7a6335;
  background: #f7f1e3;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.tag.score {
  color: #b4553a;
  background: #fdeee9;
}

.stock {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #aaa;
}

/* 简介 */
.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 14rpx;
}

.intro {
  font-size: 26rpx;
  color: #555;
  line-height: 1.75;
}

.card {
  margin-bottom: 20rpx;
}

/* 底部栏 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx calc(0rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-fav,
.bar-cart {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.bar-icon {
  font-size: 34rpx;
  color: #888;
}

.bar-icon-on {
  color: #f0a63c;
}

.bar-fav-text {
  font-size: 20rpx;
  color: #888;
  margin-top: 2rpx;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: 14rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #e6543a;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  padding: 0 6rpx;
}

.bar-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
}
