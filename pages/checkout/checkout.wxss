.page {
  padding: 24rpx 24rpx 180rpx;
}

.card {
  margin-bottom: 20rpx;
}

.card-title,
.addr-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

/* 表单行 */
.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 130rpx;
  font-size: 26rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 26rpx;
  color: #222;
}

/* 商品 */
.goods {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.goods:last-child {
  border-bottom: none;
}

.goods-cover {
  width: 90rpx;
  height: 128rpx;
  border-radius: 8rpx;
  margin-right: 18rpx;
  background: #f2f2f2;
}

.goods-body {
  flex: 1;
  min-width: 0;
}

.goods-title {
  font-size: 26rpx;
  display: block;
}

.goods-num {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #e6543a;
  font-weight: 600;
}

/* 金额 */
.line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 0;
}

.line.total {
  border-top: 1rpx solid #f2f2f2;
  margin-top: 8rpx;
  padding-top: 18rpx;
  font-weight: 700;
  color: #222;
}

.pay-price {
  color: #e6543a;
  font-size: 32rpx;
}

/* 底部 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx calc(0rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-sum {
  flex: 1;
}

.bar-label {
  font-size: 24rpx;
  color: #666;
}

.bar-price {
  color: #e6543a;
  font-size: 38rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

.submit {
  width: 260rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
