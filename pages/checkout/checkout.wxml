<view class="page">

  <!-- 收货信息 -->
  <view class="card addr">
    <view class="addr-title">收货信息</view>
    <view class="field">
      <text class="label">收货人</text>
      <input class="input" placeholder="请输入姓名" value="{{address.name}}"
             data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="11 位手机号"
             value="{{address.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">地址</text>
      <input class="input" placeholder="省 / 市 / 区 / 详细地址"
             value="{{address.detail}}" data-field="detail" bindinput="onInput" />
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="card">
    <view class="card-title">图书清单</view>
    <view class="goods" wx:for="{{items}}" wx:key="id">
      <image class="goods-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="goods-body">
        <text class="goods-title ellipsis">{{item.title}}</text>
        <text class="goods-num">×{{item.num}}</text>
      </view>
      <text class="goods-price">¥{{item.subtotal}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="field">
      <text class="label">备注</text>
      <input class="input" placeholder="选填，例如：请放门口" value="{{remark}}" bindinput="onRemark" />
    </view>
  </view>

  <!-- 金额 -->
  <view class="card">
    <view class="line"><text>商品金额</text><text>¥{{total}}</text></view>
    <view class="line"><text>运费</text><text>{{freight === 0 ? '包邮' : '¥' + freight}}</text></view>
    <view class="line total"><text>应付</text><text class="pay-price">¥{{payable}}</text></view>
  </view>

  <!-- 底部 -->
  <view class="bar">
    <view class="bar-sum">
      <text class="bar-label">应付</text>
      <text class="bar-price">¥{{payable}}</text>
    </view>
    <view class="btn-primary submit" bindtap="submit">提交订单</view>
  </view>
</view>
