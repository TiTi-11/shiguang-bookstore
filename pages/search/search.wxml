<view class="page">

  <!-- 搜索框 -->
  <view class="search">
    <image class="icon" src="/images/搜索.png" mode="aspectFit" />
    <input class="input" placeholder="书名 / 作者 / 标签" value="{{keyword}}"
           confirm-type="search" bindinput="onInput" bindconfirm="onConfirm" focus="{{true}}" />
    <text class="btn" bindtap="onConfirm">搜索</text>
  </view>

  <!-- 未搜索：历史 + 热搜 -->
  <block wx:if="{{!searched}}">
    <view class="block" wx:if="{{history.length}}">
      <view class="block-head">
        <text class="block-title">搜索历史</text>
        <text class="clear" bindtap="clearHistory">清空</text>
      </view>
      <view class="chips">
        <text class="chip" wx:for="{{history}}" wx:key="*this" data-kw="{{item}}" bindtap="tapKeyword">{{item}}</text>
      </view>
    </view>

    <view class="block">
      <view class="block-head">
        <text class="block-title">热门搜索</text>
      </view>
      <view class="chips">
        <text class="chip hot" wx:for="{{hot}}" wx:key="*this" data-kw="{{item}}" bindtap="tapKeyword">{{item}}</text>
      </view>
    </view>
  </block>

  <!-- 搜索结果 -->
  <block wx:else>
    <view class="result-head">找到 {{count}} 本相关图书</view>
    <book-card wx:for="{{results}}" wx:key="id" book="{{item}}" mode="list" bind:tap="goDetail" />
    <view class="empty" wx:if="{{!results.length}}">没有找到相关图书，换个关键词试试</view>
  </block>
</view>
