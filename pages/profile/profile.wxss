.page {
  padding: 24rpx;
}

/* 用户卡 */
.user {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2c3e50, #43596f);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fcc37a;
  margin-right: 22rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nick {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.arrow {
  color: rgba(255, 255, 255, 0.6);
  font-size: 36rpx;
}

/* 概览 */
.stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 0;
  margin-bottom: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
}

.card-more {
  font-size: 22rpx;
  color: #999;
}

.order-row {
  display: flex;
}

.order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  gap: 8rpx;
}

.oi {
  font-size: 40rpx;
}

/* 列表 */
.list {
  padding: 0 24rpx;
}

.row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.row-icon {
  width: 44rpx;
  color: #b0b0b0;
  font-size: 28rpx;
}

.row-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.row-value {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.row .arrow {
  color: #ccc;
  font-size: 30rpx;
}

.footer {
  text-align: center;
  color: #c9c9c9;
  font-size: 22rpx;
  padding: 30rpx 0;
}
