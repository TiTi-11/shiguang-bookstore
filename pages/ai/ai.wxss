page {
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f6f6;
}

/* 顶栏 */
.head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c3e50, #4a627e);
  color: #fcc37a;
  font-weight: 700;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.head-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
}

.head-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.head-clear {
  font-size: 24rpx;
  color: #aaa;
}

/* 对话 */
.chat {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 0;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

.bubble {
  max-width: 84%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  line-height: 1.65;
}

.bubble-ai {
  background: #fff;
  border-top-left-radius: 6rpx;
}

.bubble-user {
  background: #fcc37a;
  color: #3a2a12;
  border-top-right-radius: 6rpx;
}

.text {
  font-size: 27rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.caret {
  color: #b07a2a;
  font-size: 24rpx;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

/* 推荐书目 */
.books {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  width: 100%;
}

.book {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.book-cover {
  width: 100%;
  height: 180rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  background: #f2f2f2;
}

.book-title {
  font-size: 22rpx;
  color: #333;
  width: 100%;
  text-align: center;
}

.book-price {
  font-size: 22rpx;
  color: #e6543a;
  margin-top: 4rpx;
}

.chat-pad {
  height: 24rpx;
}

/* 快捷提问 */
.chips {
  white-space: nowrap;
  padding: 12rpx 24rpx;
  background: #f6f6f6;
}

.chip {
  display: inline-block;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

/* 输入栏 */
.bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.input {
  flex: 1;
  height: 76rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.send {
  margin-left: 16rpx;
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fcc37a;
  color: #4a3216;
  font-size: 26rpx;
  font-weight: 600;
}

.send-dis {
  background: #f0e0c8;
  color: #b5a084;
}
