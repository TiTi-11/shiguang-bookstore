.page {
  padding: 24rpx;
}

.hero {
  background: linear-gradient(160deg, #fff4e2, #ffe7c4);
  border-radius: 20rpx;
  padding: 48rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.tick {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fcc37a;
  color: #4a3216;
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.hero-sub {
  font-size: 24rpx;
  color: #8a7360;
  margin-top: 8rpx;
}

.hero-price {
  font-size: 56rpx;
  font-weight: 700;
  color: #e6543a;
  margin-top: 20rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
}

.k {
  color: #999;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.v {
  color: #333;
  text-align: right;
  word-break: break-all;
}

.addr {
  max-width: 420rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.goods {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.goods:last-child {
  border-bottom: none;
}

.goods-cover {
  width: 84rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: #f2f2f2;
}

.goods-body {
  flex: 1;
  min-width: 0;
}

.goods-title {
  font-size: 26rpx;
  display: block;
}

.goods-num {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #e6543a;
}

.btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
