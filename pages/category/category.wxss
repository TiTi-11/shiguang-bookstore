page {
  height: 100%;
  overflow: hidden;
}

.wrap {
  display: flex;
  height: 100vh;
  background: #f6f6f6;
}

/* 左侧分类栏 */
.side {
  width: 180rpx;
  height: 100%;
  background: #f0f0f0;
}

.side-item {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.side-item-on {
  background: #fff;
  color: #2c3e50;
  font-weight: 700;
}

.side-item-on::before {
  content: "";
  position: absolute;
  left: 0;
  top: 26rpx;
  bottom: 26rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #fcc37a;
}

/* 右侧 */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-width: 0;
}

.main-head {
  display: flex;
  align-items: baseline;
  padding: 20rpx 24rpx 8rpx;
}

.main-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.main-count {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 12rpx;
  flex: 1;
}

.main-search {
  font-size: 24rpx;
  color: #b07a2a;
}

.sorts {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 24rpx 16rpx;
}

.sort {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 0;
}

.sort-on {
  color: #2c3e50;
  font-weight: 700;
  border-bottom: 4rpx solid #fcc37a;
}

.list {
  flex: 1;
  padding: 0 20rpx 20rpx;
  height: 0;
}
