.page {
  padding: 80rpx 48rpx 40rpx;
  min-height: 100vh;
  background: #fff;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #fcc37a;
  color: #4a3216;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
}

.sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.form {
  margin-bottom: 40rpx;
}

.avatar-btn {
  background: #fff;
  padding: 0;
  margin: 0 auto 40rpx;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.avatar-tip {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding: 24rpx 0;
}

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.submit {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.skip {
  display: block;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 28rpx;
}

.tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 0 48rpx;
}
