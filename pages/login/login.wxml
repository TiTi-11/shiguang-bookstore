<view class="page">

  <view class="brand">
    <view class="logo">拾光</view>
    <text class="title">欢迎回来</text>
    <text class="sub">登录后可同步收藏与订单</text>
  </view>

  <view class="form">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <text class="avatar-tip">点击选择头像</text>
    </button>

    <view class="field">
      <text class="label">昵称</text>
      <input class="input" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNickName" />
    </view>
  </view>

  <view class="btn-primary submit" bindtap="submit">登录</view>
  <text class="skip" bindtap="skip">先随便看看</text>

  <view class="tip">本项目为演示用，登录态仅保存在本地，不会上传任何信息。</view>
</view>
