.bc {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 竖版卡片 */
.bc-grid {
  width: 100%;
  padding: 12rpx;
}

.bc-grid .bc-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.bc-grid .bc-body {
  padding: 12rpx 4rpx 4rpx;
}

/* 横版行 */
.bc-list {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.bc-list .bc-cover {
  width: 140rpx;
  height: 196rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.bc-list .bc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.bc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.bc-author {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.bc-list .bc-title {
  font-size: 30rpx;
}

.bc-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
}

.bc-price {
  color: #e6543a;
  font-size: 30rpx;
  font-weight: 600;
}

.bc-sales {
  font-size: 22rpx;
  color: #aaa;
}
